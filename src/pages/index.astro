function setFinalPrefectureMode(isFinal) {
  if (!map || !map.getLayer('pref1876-fill')) return;
  const oldOpacity=isFinal?0:0.55, oldLineOpacity=isFinal?0:0.95, hanOpacity=isFinal?0:0.8, hanLineOpacity=isFinal?0:0.4, prefOpacity=isFinal?0.62:0, prefLineOpacity=isFinal?0.95:0;
  map.setPaintProperty('kuni-fill','fill-opacity',oldOpacity); map.setPaintProperty('kuni-line','line-opacity',oldLineOpacity);
  map.setPaintProperty('han-fill','fill-opacity',hanOpacity); map.setPaintProperty('han-line','line-opacity',hanLineOpacity);
  map.setPaintProperty('pref1876-fill','fill-opacity',prefOpacity); map.setPaintProperty('pref1876-line','line-opacity',prefLineOpacity);
  Object.values(kuniLabelMarkers).forEach(m=>m.getElement().style.display=isFinal?'none':'');
  hanLabelMarkers.forEach(o=>o.m.getElement().style.display=isFinal?'none':(map.getZoom()>=o.minZ?'':'none'));
  pref1876LabelMarkers.forEach(m=>m.getElement().style.display=isFinal?'':'none'); special1876LabelMarkers.forEach(m=>m.getElement().style.display=isFinal?'':'none');
  const stance=document.querySelector('.stance-legend'); if(stance) stance.style.display=isFinal?'none':'';
  const note=document.querySelector('.han-note'); if(note) note.textContent=isFinal?'1876年8月21日の第二次府県統合後。旧国名・幕末の藩領表示はこのスライドでは非表示。北海道は開拓使、沖縄は琉球藩。':'藩領は幕末期近世村領域データセットの村点(領分)から作成した概略です。藩名はズームすると順に表示されます。北海道・沖縄はデータがありません。';
}

function renderPhase(idx) {
  const p = phases[idx];
  document.getElementById('tpYear').textContent = p.year;
  document.getElementById('tpTitle').textContent = p.title;
  document.getElementById('tpDesc').textContent = p.desc;
  document.getElementById('tpSlider').value = idx;

  setFinalPrefectureMode(p.title === '西南戦争');
  if(map && map.getLayer('han-fill')) map.setPaintProperty('han-fill','fill-color',p.title === '戊辰戦争' ? ['get','boshinColor'] : ['get','color']);
  if(eventMarker){ eventMarker.getElement().classList.toggle('boshin-event',p.title === '戊辰戦争'); eventMarker.getElement().style.zIndex='1000'; }
  const bl=document.querySelector('.boshin-legend'); if(bl) bl.style.display=p.title === '戊辰戦争'?'flex':'none';

  updateKuniColors(idx);

  const boundsLngLat = [];

  ['ryoma', 'saigo', 'takasugi'].forEach(key => {
    const data = p[key];
    const marker = markers[key];
    if (data) {
      if (!markerActive[key]) {
        marker.setLngLat([data.lng, data.lat]);
        marker.addTo(map);
        markerActive[key] = true;
      } else {
        const from = marker.getLngLat();
        animateMarker(marker, { lat: from.lat, lng: from.lng }, data, 700);
      }
      boundsLngLat.push([data.lng, data.lat]);
    } else {
      if (markerActive[key]) {
        marker.remove();
        markerActive[key] = false;
      }
    }
  });

  const ef = eventMarker.getLngLat();
  const efObj = (ef && idx !== 0) ? { lat: ef.lat, lng: ef.lng } : null;
  animateMarker(eventMarker, efObj, p.event, 700);

  eventPopup.setHTML(`<strong>${p.event.name}</strong>`);
  if (!eventMarker.getPopup().isOpen()) {
    eventMarker.togglePopup();
  }

  boundsLngLat.push([p.event.lng, p.event.lat]);

  if (boundsLngLat.length > 0) {
    let minLng = boundsLngLat[0][0], maxLng = boundsLngLat[0][0];
    let minLat = boundsLngLat[0][1], maxLat = boundsLngLat[0][1];
    boundsLngLat.forEach(pt => {
      if (pt[0] < minLng) minLng = pt[0];
      if (pt[0] > maxLng) maxLng = pt[0];
      if (pt[1] < minLat) minLat = pt[1];
      if (pt[1] > maxLat) maxLat = pt[1];
    });

    map.fitBounds([
      [minLng, minLat],
      [maxLng, maxLat]
    ], { padding: { top: 60, bottom: 60, left: 60, right: 60 }, maxZoom: 7, duration: 900 });
  }
}

function goTo(idx) {
  current = Math.max(0, Math.min(phases.length - 1, idx));
  renderPhase(current);
}

function togglePlay() {
  const btn = document.getElementById('btnPlay');
  if (playTimer) {
    clearInterval(playTimer); playTimer = null;
    btn.innerHTML = '&#9654;'; btn.title = '自動再生';
  } else {
    btn.innerHTML = '&#10074;&#10074;'; btn.title = '一時停止';
    playTimer = setInterval(() => {
      if (current >= phases.length - 1) { current = -1; }
      goTo(current + 1);
    }, 2600);
  }
}

document.addEventListener('DOMContentLoaded', function() {
  map = new maplibregl.Map({
    container: 'japanMap',
    style: {
      version: 8,
      sources: {
        'gsi-photo-tiles': {
          type: 'raster',
          tiles: ['https://cyberjapandata.gsi.go.jp/xyz/seamlessphoto/{z}/{x}/{y}.jpg'],
          tileSize: 256,
          attribution: '<a href="https://maps.gsi.go.jp/development/ichiran.html" target="_blank">国土地理院（写真）</a>'
        }
      },
      layers: [
        {
          id: 'gsi-photo-layer',
          type: 'raster',
          source: 'gsi-photo-tiles'
        }
      ]
    },
    center: [136.0, 36.5],
    zoom: 5.5
  });

  markers.ryoma = createPersonMarker('#2d5fa3', '龍', '坂本龍馬');
  markers.saigo = createPersonMarker('#a5372a', '西', '西郷隆盛');
  markers.takasugi = createPersonMarker('#2f7d4f', '晋', '高杉晋作');

  eventMarker = createEventMarker();
  eventMarker.setLngLat([phases[0].event.lng, phases[0].event.lat]);
  eventMarker.addTo(map);


  document.getElementById('tpSlider').addEventListener('input', e => { goTo(parseInt(e.target.value, 10)); });
  document.getElementById('btnPrev').addEventListener('click', () => { if (playTimer) togglePlay(); goTo(current - 1); });
  document.getElementById('btnNext').addEventListener('click', () => { if (playTimer) togglePlay(); goTo(current + 1); });
  document.getElementById('btnPlay').addEventListener('click', togglePlay);

  map.on('load', function() {
    map.addSource('kuni', { type: 'geojson', data: KUNI_GEOJSON });
    map.addLayer({
      id: 'kuni-fill', type: 'fill', source: 'kuni',
      paint: { 'fill-color': NEUTRAL_FILL, 'fill-opacity': 0.55 }
    });
    map.addLayer({
      id: 'kuni-line', type: 'line', source: 'kuni',
      paint: { 'line-color': '#3a3222', 'line-width': 1.8, 'line-opacity': 0.95 }
    });

    // 藩領（村点のボロノイ分割）。国塗りの上、国境線の下に描く。藩ごとに同じ家格内で色味をずらして隣り合う藩を区別
    function shade(hex, f) {
      const n = parseInt(hex.slice(1), 16);
      const ch = [n >> 16 & 255, n >> 8 & 255, n & 255].map(v => Math.round(f >= 0 ? v + (255 - v) * f : v * (1 + f)));
      return '#' + ch.map(v => v.toString(16).padStart(2, '0')).join('');
    }
    HAN_GEOJSON.features.forEach(f => {
      let hsh = 0;
      for (const ch of f.properties.h) hsh = (hsh * 31 + ch.charCodeAt(0)) % 997;
      const j = (hsh % 9 - 4) / 4 * 0.14;
      f.properties.color = ['bakufu','hatamoto','sankyo','other'].includes(f.properties.c) ? CATEGORY_COLOR[f.properties.c] : shade(CATEGORY_COLOR[f.properties.c], j);
      if(BOSHIN_REDS.has(f.properties.h)) f.properties.boshinColor=BOSHIN_RED;
      else if(BOSHIN_AIZU.has(f.properties.h)) f.properties.boshinColor=BOSHIN_GREEN;
      else if(BOSHIN_ALLIANCE.has(f.properties.h)) f.properties.boshinColor=BOSHIN_LIGHT_GREEN;
      else f.properties.boshinColor=BOSHIN_PINK;
    });
    map.addSource('han', { type: 'geojson', data: HAN_GEOJSON });
    map.addLayer({
      id: 'han-fill', type: 'fill', source: 'han',
      paint: { 'fill-color': ['get', 'color'], 'fill-opacity': 0.8 }
    }, 'kuni-line');
    map.addLayer({
      id: 'han-line', type: 'line', source: 'han',
      paint: { 'line-color': '#2b2620', 'line-width': 0.45, 'line-opacity': 0.28, 'line-join': 'round', 'line-cap': 'round' }
    }, 'kuni-line');

    function prefColor(name){ let h=0; for(const ch of name) h=(h*31+ch.charCodeAt(0))%360; return `hsl(${h},42%,72%)`; }
    PREF1876_GEOJSON.features.forEach(f=>f.properties.color=prefColor(f.properties.name));
    map.addSource('pref1876',{type:'geojson',data:PREF1876_GEOJSON});
    map.addLayer({id:'pref1876-fill',type:'fill',source:'pref1876',paint:{'fill-color':['get','color'],'fill-opacity':0}});
    map.addLayer({id:'pref1876-line',type:'line',source:'pref1876',paint:{'line-color':'#2d2922','line-width':1.7,'line-opacity':0}});
    PREF1876_GEOJSON.features.forEach(f=>{ const el=document.createElement('div'); el.className='han-pin'; el.innerHTML=`<div class="label">${f.properties.name}</div>`; const m=new maplibregl.Marker({element:el,anchor:'center'}).setLngLat([f.properties.lon,f.properties.lat]).addTo(map); m.getElement().style.display='none'; pref1876LabelMarkers.push(m); });
    [['開拓使',141.35,43.06],['琉球藩',127.68,26.21]].forEach(([name,lng,lat])=>{ const el=document.createElement('div'); el.className='han-pin'; el.innerHTML=`<div class="label">${name}</div>`; const m=new maplibregl.Marker({element:el,anchor:'center'}).setLngLat([lng,lat]).addTo(map); m.getElement().style.display='none'; special1876LabelMarkers.push(m); });

    // 旧国名ラベル(DOM)
    KUNI_GEOJSON.features.forEach(f => {
      const el = document.createElement('div');
      el.className = 'kuni-label';
      el.textContent = f.properties.name;
      const m = new maplibregl.Marker({ element: el, anchor: 'center' })
        .setLngLat([f.properties.lon, f.properties.lat]).addTo(map);
      kuniLabelMarkers[f.properties.name] = m;
    });

    // 藩名ラベル(DOM)。規模(村数)に応じてズームで段階的に表示
    hanLabelMarkers = [];
    HAN_LABELS.forEach(l => {
      const el = document.createElement('div');
      el.className = 'han-pin';
      el.innerHTML = `<div class="dot" style="background:${CATEGORY_COLOR[l.c]}"></div><div class="label">${l.n}</div>`;
      const minZ = l.v >= 500 ? 5.0 : l.v >= 250 ? 6.0 : l.v >= 120 ? 6.8 : l.v >= 60 ? 7.6 : 8.4;
      const m = new maplibregl.Marker({ element: el, anchor: 'center' }).setLngLat([l.x, l.y]).addTo(map);
      hanLabelMarkers.push({ m, minZ });
    });

    function refreshLabelVisibility() {
      const z = map.getZoom();
      const show = z >= 5.8 ? '1' : '0';
      Object.values(kuniLabelMarkers).forEach(m => { m.getElement().style.opacity = show; });
      hanLabelMarkers.forEach(o => { o.m.getElement().style.display = z >= o.minZ ? '' : 'none'; });
    }
    map.on('zoom', refreshLabelVisibility);
    refreshLabelVisibility();


    renderPhase(0);
  });

  const modal = document.getElementById('profileModal');
  document.querySelector('.close').onclick = () => modal.style.display = 'none';
  window.onclick = e => { if (e.target === modal) modal.style.display = 'none'; };
});

function showProfile(id) {
  const person = shishiData[id];
  let html = `<h2>${person.name}</h2><div class="timeline">`;
  person.timeline.forEach(item => {
    html += `<div class="timeline-item"><div class="timeline-year">${item.year}年</div><div>${item.event}</div></div>`;
  });
  html += '</div>';
  document.getElementById('profileContent').innerHTML = html;
  document.getElementById('profileModal').style.display = 'block';
}
</script>
</body>
</html>
