---
import BaseLayout from '../layouts/BaseLayout.astro';
import Thumb from '../components/Thumb.astro';
import '../styles/map.css';
import { PILLARS, LATEST } from '../data/pillars.js';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const find = (pid, slug) => { const p = PILLARS.find((x) => x.id === pid); return { p, it: p.items.find((i) => i.slug === slug) }; };
const latest = LATEST.map((l) => ({ ...l, ...find(l.pillar, l.slug) }));
---
<BaseLayout title="幕末維新MAP - 地図で時代をたどる">
  <link slot="head" href="https://cdn.jsdelivr.net/npm/maplibre-gl@4.7.1/dist/maplibre-gl.css" rel="stylesheet" />

  <div class="intro-wrap">
    <div class="container intro">
      <div class="era">嘉永六年 — 明治十年</div>
      <h1>時代を駆け抜けた<br>志士たちの物語</h1>
      <p>黒船来航から西南戦争まで。地図をたどりながら、志士たちの足跡と、その時代に起きた出来事を読むことができます。</p>
      <a class="btn" href="#map">地図で見る</a>
    </div>
  </div>

  <section id="map">
    <div class="container">
      <div class="filters" id="tabs" role="group" aria-label="地図に表示する項目"></div>
      <div class="mapbox">
        <div class="timeline-bar">
          <div class="tl-left">
            <div class="tl-year" id="tlYear">1853年</div>
            <div class="tl-wareki" id="tlWareki"></div>
            <div class="tl-ev" id="tlEv"></div>
          </div>
          <div class="sl">
            <div class="trunk">
              <input id="range" type="range" min="1853" max="1877" value="1853" step="1" aria-label="年を選ぶ">
              <div class="marks" id="marks"></div>
            </div>
            <div class="ticks"><span>1853 黒船来航</span><span>1868 戊辰戦争</span><span>1877 西南戦争</span></div>
          </div>
        </div>
        <div class="stage">
          <div class="view">
            <div id="japanMap" class="japan-map"></div>
            <div class="loading" id="loading">地図を読み込んでいます…</div>
            <button class="fit" id="fit" type="button">全体を見る</button>
          </div>
          <aside class="panel" aria-live="polite" id="panel"><div class="handle" aria-hidden="true"></div><div id="pbody"></div></aside>
        </div>
      </div>
      <div class="map-legends">
        <div class="tp-legend" id="pinLegend"></div>
        <div class="stance-legend">
          <span><i style="background:#b23b3b"></i>御三家</span><span><i style="background:#c98cc0"></i>親藩</span>
          <span><i style="background:#e0952e"></i>譜代</span><span><i style="background:#4f8f52"></i>外様</span>
          <span><i style="background:#5d7396"></i>幕領</span><span><i style="background:#9fb1cc"></i>旗本領</span>
          <span><i style="background:#7d8fb3"></i>三卿領</span><span><i style="background:#cfc6ad"></i>社寺・公家領など</span>
        </div>
        <div class="boshin-legend" style="display:none">
          <span><i style="background:#c0392b"></i>薩摩・長州・土佐・肥前</span><span><i style="background:#5d8f58"></i>会津</span>
          <span><i style="background:#a9c7a0"></i>奥羽越列藩同盟</span><span><i style="background:#e9968c"></i>その他</span>
        </div>
        <div class="hakodate-legend" style="display:none">
          <span><i style="background:#4a5fa8"></i>実質的な支配区域(道南)</span><span><i style="background:#a9c7a0"></i>名目上の支配区域(蝦夷地全域)</span><span><i style="background:#e9968c"></i>明治政府側</span>
        </div>
        <p class="han-note">藩領は幕末期近世村領域データセットの村点(領分)から作成した概略です。藩名はズームすると順に表示されます。北海道・沖縄はデータがありません。</p>
      </div>
    </div>
  </section>

  <section id="latest">
    <div class="container">
      <div class="head"><h2>最新記事</h2><p>新しく公開した記事</p></div>
      <div class="news">
        {latest.map((l) => (
          <a class="ncard" href={`${base}/${l.pillar}/${l.slug}/`}>
            <div class="nimg">
              {l.img ? <><img src={`${base}/shishi/${l.img}`} alt={`${l.it.n}のイメージ画像`} loading="lazy" /><span class="cap">イメージ画像</span></> : <Thumb label={`${l.it.n}の地図`} />}
            </div>
            <div class="nbody">
              <span class="kind" style={`background:${l.p.c}`}>{l.p.t}</span>
              <h3>{l.it.n}</h3>
              <div class="ndate">{l.it.sub.split('|')[0]}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="more">
    <div class="container">
      <div class="head"><h2>もっと読む</h2><p>気になる項目の一覧へ</p></div>
      <div class="rows">
        {PILLARS.map((p) => (
          <a class="row" href={`${base}/${p.id}/`} style={`--c:${p.c}`}>
            <div><h2>{p.t}</h2><p>{p.desc}</p></div>
            <span class="more">{p.t}の一覧へ</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <script is:inline src="https://cdn.jsdelivr.net/npm/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>
  <script>
    import '../scripts/home-map.js';
  </script>
</BaseLayout>
