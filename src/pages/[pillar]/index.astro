---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PILLARS } from '../../data/pillars.js';
export function getStaticPaths() { return PILLARS.map((p) => ({ params: { pillar: p.id }, props: { p } })); }
const { p } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const SL = { kana: 'あいうえお順', year: '時系列', north: '北から南' };
const items = [...p.items].sort((a, b) => a.k.localeCompare(b.k, 'ja'));
---
<BaseLayout title={`${p.t}の一覧 | 幕末維新MAP`} description={p.desc}>
  <div class="container" style={`--c:${p.c}`}>
    <div class="crumb"><a href={`${base}/`}>ホーム</a> &gt; {p.t}</div>
    <div class="listhead"><h1>{p.t}</h1><p>{p.desc}</p></div>
    <div class="toolbar">
      <div class="sorts" id="sorts" role="group" aria-label="並べ替え">
        {p.sorts.map((k, j) => <button type="button" data-k={k} aria-pressed={j === 0 ? 'true' : 'false'}>{SL[k]}</button>)}
      </div>
      <span style="color:var(--mute);font-size:14px">{p.items.length}件</span>
    </div>
    <div class="pgrid" id="grid">
      {items.map((it) => (
        <a class="pcard" href={`${base}/${p.id}/${it.slug}/`} style={`--c:${p.c}`} data-k={it.k} data-y={it.y ?? ''} data-lat={it.lat ?? ''}>
          <h3>{it.n}</h3>
          <div class="sub">{it.sub.split('|').join(' / ')}</div>
          <span class="go">詳細ページへ</span>
        </a>
      ))}
    </div>
    <p style="margin:28px 0 0"><a class="more" href={`${base}/#map`}>地図にもどる</a></p>
  </div>
  <script>
    const grid = document.getElementById('grid');
    const sorts = document.getElementById('sorts');
    const key = {
      kana: (a, b) => a.dataset.k.localeCompare(b.dataset.k, 'ja'),
      year: (a, b) => (+a.dataset.y || 9999) - (+b.dataset.y || 9999),
      north: (a, b) => (+b.dataset.lat || 0) - (+a.dataset.lat || 0),
    };
    sorts?.addEventListener('click', (e) => {
      const b = e.target.closest('button'); if (!b) return;
      sorts.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      [...grid.children].sort(key[b.dataset.k]).forEach((c) => grid.appendChild(c));
    });
    // 最初の並び順に合わせる
    const first = sorts?.querySelector('button');
    if (first) [...grid.children].sort(key[first.dataset.k]).forEach((c) => grid.appendChild(c));
  </script>
</BaseLayout>
